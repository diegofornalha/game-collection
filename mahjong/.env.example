# Configuração do Sentry - Mahjong Game
# Copie este arquivo para .env e preencha com suas credenciais

# === CONFIGURAÇÃO BÁSICA ===
# DSN do projeto Sentry (obtenha em: Settings > Projects > Client Keys)
VITE_SENTRY_DSN=your_sentry_dsn_here

# Ambiente da aplicação (development, staging, production)
VITE_SENTRY_ENVIRONMENT=development

# Versão da aplicação (use versionamento semântico)
VITE_SENTRY_RELEASE=mahjong@1.0.0

# === SESSION REPLAY ===
# Taxa de amostragem para sessões normais (0.0 a 1.0)
# 0.1 = 10% das sessões serão gravadas
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1

# Taxa de amostragem para sessões com erros (0.0 a 1.0)
# 1.0 = 100% das sessões com erros serão gravadas
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0

# === PERFORMANCE MONITORING ===
# Taxa de amostragem para rastreamento de performance (0.0 a 1.0)
# 0.3 = 30% das transações serão monitoradas
VITE_SENTRY_TRACES_SAMPLE_RATE=0.3

# === CONFIGURAÇÕES DE PRIVACIDADE ===
# Mascarar todo texto em replays (true/false)
# true = textos serão ocultados nos replays
VITE_SENTRY_MASK_ALL_TEXT=true

# Bloquear toda mídia em replays (true/false)
# false = imagens e vídeos serão capturados
VITE_SENTRY_BLOCK_ALL_MEDIA=false

# === CONFIGURAÇÕES OPCIONAIS ===
# Token de autenticação da API (para upload de source maps)
SENTRY_AUTH_TOKEN=seu_token_aqui

# Organização no Sentry
SENTRY_ORG=sua_organizacao

# Nome do projeto no Sentry
SENTRY_PROJECT=mahjong